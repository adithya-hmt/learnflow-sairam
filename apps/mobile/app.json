{
  "expo": {
    "name": "LearnFlow",
    "slug": "learnflow-sairam",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "learnflow",
    "backgroundColor": "#F5F7FA",
    "primaryColor": "#2563EB",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "edu.sairam.learnflow",
      "versionCode": 4,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FA",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-sqlite",
      "expo-secure-store",
      "expo-video",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7FA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser"
    ]
  }
}
